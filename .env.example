# Local-only defaults. Replace JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-unique-random-secret
POSTGRES_PASSWORD=ats-local-only
SEED_DEMO=1

# Optional Plunk hosted email delivery. Configure only after verifying a sending domain in Plunk.
# EMAIL_PROVIDER=plunk
# PLUNK_SECRET_KEY=sk_replace_with_your_plunk_secret_key
# PLUNK_FROM=notifications@your-verified-domain.com

# Optional Brevo hosted transactional email. Verify your sender address in Brevo. Without your own domain, Brevo may replace the sender domain with its own sending domain.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib_replace_with_your_brevo_api_key
# BREVO_FROM_EMAIL=notifications@your-verified-domain.com
# BREVO_FROM_NAME=HirePath ATS
